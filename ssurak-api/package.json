    "@nestjs/platform-socket.io": "^11.1.23",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/websockets": "^11.1.23",
    "@paralleldrive/cuid2": "^3.0.4",
    "@prisma/client": "^6.19.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@ssurak/db": "workspace:*",
    "@ssurak/schema": "workspace:*",
