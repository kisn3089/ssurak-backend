  "scripts": {
    "build": "nest build && vite build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "vite-node src/main.ts",
    "dev": "nodemon",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --enable-source-maps dist/main.mjs",
