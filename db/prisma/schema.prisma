generator client {
  provider = "prisma-client-js"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  /**
   * 모든 권한을 소유한 관리자
   */
  SUPER
  /**
   * 일부 기능에 대한 write 권한을 소유한 관리자
   */
  SUPPORT
  /**
   * Readonly 권한만 소유한 관리자
   */
  VIEWER
}

model Admin {
  id           BigInt    @id @default(autoincrement())
  publicId     String    @unique @default(cuid(2)) @map("public_id")
  email        String    @unique
  password     String
  name         String
  role        AdminRole @default(VIEWER)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("admin")
}

/**
 * 로그인(기기)별 인증 세션.
 * 계정당 여러 행을 허용해 멀티 디바이스 로그인을 지원한다 —
 * 새 로그인이 다른 기기의 세션을 무효화하지 않는다.
 * tokenHash는 refresh token의 SHA-256 해시이며 원문은 저장하지 않는다.
 */
model AuthSession {
  id        BigInt   @id @default(autoincrement())
  /**
   * TokenPayload["role"] — "owner" | "admin"
   */
  role      String   @db.VarChar(16)
  userId    BigInt   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([role, userId])
  @@map("auth_session")
}

/**
 * 매장 사장님 모델
 * 추후 권한 관리가 필요할 수 있음
 */
model Owner {
  id             BigInt    @id @default(autoincrement())
  publicId       String    @unique @default(cuid(2)) @map("public_id")
  email          String    @unique
  password       String
  name           String
  phone          String
  businessNumber String?   @unique @map("business_number")
  isActive       Boolean   @default(false) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  stores Store[]

  @@map("owner")
}

model Store {
  id              BigInt   @id @default(autoincrement())
  publicId        String   @unique @default(cuid(2)) @map("public_id")
  ownerId         BigInt   @map("owner_id")
  name            String
  phone           String?
  address         String
  addressDetail   String?  @map("address_detail")
  description     String?  @db.Text
  /**
   * 영업시간과 무관하게 점주가 주문을 즉시 막는 "일시 중지" 스위치.
   * 영업 여부 판정에서 가장 먼저 평가된다 — false면 영업시간 안이어도 주문을 받지 않는다.
   */
  isOpen          Boolean  @default(true) @map("is_open")
  acceptedMessage String?  @map("accepted_message") @db.VarChar(500)
  /** 영업시간 판정 기준 타임존. DateTime은 UTC로 저장되므로 판정에는 이 값이 필수다. */
  timezone        String   @default("Asia/Seoul") @db.VarChar(40)
  /**
   * 영업일 경계(자정 기준 분). 기본 300 = 새벽 5시.
   * 이 시각 이전의 주문은 "전날 영업일"로 묶인다 — 주문번호 리셋 기준점이다.
   * 제약: 모든 openMinute >= cutoff, 모든 closeMinute <= 1440 + cutoff.
   * (어제 마감과 오늘 오픈 사이의 빈 구간에 있어야 한다)
   */
  businessDayCutoff Int    @default(300) @map("business_day_cutoff")
  /** 주문번호 접두사. "A-0001"의 "A". */
  orderNumberPrefix String @default("A") @map("order_number_prefix") @db.VarChar(4)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  owner      Owner      @relation(fields: [ownerId], references: [id])
  tables     Table[]
  orders     Order[]
  categories Category[]
  /// 관계 필드명을 `businessHours`로 두어 조회 결과 모양이 곧 API 응답 모양이 되게 한다.
  businessHours StoreBusinessHour[]
  closures      StoreClosure[]

  @@map("store")
}

/**
 * 요일별 정기 영업시간. 요일당 정확히 1행.
 * 시각을 "HH:mm"이 아니라 자정 기준 분(Int)으로 저장한다 — 파싱 없이 대소 비교만으로
 * 판정되고, 자정을 넘기는 영업(18:00~02:00 → 1080~1560)을 closeMinute > 1440으로
 * 표현할 수 있다.
 */
model StoreBusinessHour {
  id        BigInt @id @default(autoincrement())
  storeId   BigInt @map("store_id")
  /** 0=일 ~ 6=토. JS Date#getDay()와 같은 값이라 변환 코드가 필요 없다. */
  dayOfWeek Int    @map("day_of_week") @db.TinyInt
  /**
   * 정기 휴무 요일. true면 open/close는 무시된다 —
   * 행을 지우지 않고 플래그만 토글해야 휴무를 해제했을 때 이전 시간이 살아난다.
   */
  isClosed         Boolean  @default(false) @map("is_closed")
  openMinute       Int      @map("open_minute")
  closeMinute      Int      @map("close_minute")
  /** 브레이크타임. 둘 다 null이면 없음. */
  breakStartMinute Int?     @map("break_start_minute")
  breakEndMinute   Int?     @map("break_end_minute")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, dayOfWeek])
  @@map("store_business_hour")
}

/** 특정 날짜의 임시 휴무 또는 특별 영업시간. 정기 영업시간보다 우선한다. */
model StoreClosure {
  id       BigInt  @id @default(autoincrement())
  publicId String  @unique @default(cuid(2)) @map("public_id")
  storeId  BigInt  @map("store_id")
  date     String  @db.Char(10)
  reason   String? @db.VarChar(100)
  /**
   * 둘 다 null이면 종일 휴무.
   * 값이 있으면 그날만 이 시간으로 영업한다(단축 영업·명절 특별 영업).
   */
  openMinute  Int?     @map("open_minute")
  closeMinute Int?     @map("close_minute")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date])
  @@map("store_closure")
}

/**
 * 매장 메뉴의 분류
 * 매장 → 카테고리 → 메뉴 계층 구조
 */
model Category {
  id       BigInt @id @default(autoincrement())
  publicId String @unique @default(cuid(2)) @map("public_id")
  storeId  BigInt @map("store_id")
  name     String
  /**
   * 카테고리 표시 순서 (Sparse 패턴)
   * 10, 20, 30... 으로 부여하여 사이 삽입 시 15만 넣으면 됨.
   * 가득 차면 재정규화(10, 20, 30... 재할당) 필요.
   * orderBy: { sortOrder: 'asc' }
   */
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store  @relation(fields: [storeId], references: [id])
  menus Menu[]

  @@unique([storeId, name])
  @@map("category")
}

/**
 * 매장의 테이블 정보
 * 테이블별 메타데이터와 상태를 관리
 */
model Table {
  id          BigInt   @id @default(autoincrement())
  publicId    String   @unique @default(cuid(2)) @map("public_id")
  storeId     BigInt   @map("store_id")
  tableNumber String   @map("table_number") @db.VarChar(10)
  seats       Int?     
  /**
   * 층수 (1층, 2층 등)
   */
  floor       Int?
  /**
   * 구역 (예: "A구역", "야외", "룸")
   */
  section     String?
  isActive    Boolean  @default(true) @map("is_active")
  qrCode      String   @unique @default(cuid(2)) @map("qr_code")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store         Store          @relation(fields: [storeId], references: [id])
  orders        Order[]
  tableSessions TableSession[]

  @@unique([storeId, tableNumber])
  @@map("table")
}

/**
 * 사장님이 등록하는 매장 메뉴이자, 고객이 주문할 때 선택하는 메뉴
 */
model Menu {
  id              BigInt    @id @default(autoincrement())
  publicId        String    @unique @default(cuid(2)) @map("public_id")
  categoryId      BigInt    @map("category_id")
  name            String
  price           Int
  description     String?   @db.VarChar(500)
  /// S3 object key의 prefix(`menu/{cuid}`). variant와 확장자는 뺀다.
  /// 절대 URL이 아니라 key만 저장해야 CDN 도메인·버킷이 바뀌어도 레코드가 살아남는다.
  imageKey        String?   @map("image_key") @db.VarChar(255)
  isAvailable     Boolean   @default(true) @map("is_available")
  /**
   * 카테고리 내 메뉴 표시 순서 (Sparse 패턴: 10, 20, 30...)
   * orderBy: [{ category: { sortOrder: 'asc' } }, { sortOrder: 'asc' }]
   */
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  // MVP 기능은 아니기 때문에 일단 보류
  // switchMenu ice_americano 선택 시 상세 페이지에서 변경 가능한 메뉴(예시: 스타벅스) hot_americano 등으로 변경할 수 있도록 menu 선택지 제공

  category   Category          @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  /// 관계 필드명을 `optionGroups`가 아니라 `options`로 둔다 — 조회 결과 모양이 곧 API 응답 모양이라
  /// 매퍼에서 키를 갈아끼울 일이 없다.
  options    MenuOptionGroup[]

  @@index([categoryId, sortOrder])
  @@map("menu")
}

/**
 * 옵션 그룹의 선택 방식
 */
enum OptionSelectionType {
  /**
   * 그룹에서 하나만 고른다 (maxSelect는 항상 1)
   */
  SINGLE
  /**
   * 그룹에서 minSelect~maxSelect 개를 고른다
   */
  MULTIPLE
}

/**
 * 선택지의 판매 상태
 */
enum OptionChoiceState {
  AVAILABLE
  /**
   * 목록에는 보이지만 고를 수 없다 (품절 표시)
   */
  SOLD_OUT
  /**
   * 고객에게 아예 노출되지 않는다. 점주 콘솔에서만 보인다
   */
  HIDDEN
}

/**
 * 메뉴에 딸린 옵션 그룹(예: "온도", "샷 추가")
 */
model MenuOptionGroup {
  id            BigInt              @id @default(autoincrement())
  publicId      String              @unique @default(cuid(2)) @map("public_id")
  menuId        BigInt              @map("menu_id")
  name          String              @db.VarChar(30)
  selectionType OptionSelectionType @default(SINGLE) @map("selection_type")
  required      Boolean             @default(false)
  minSelect     Int                 @default(0) @map("min_select")
  maxSelect     Int                 @default(1) @map("max_select")
  /**
   * 메뉴 안 옵션 표시 순서 (Sparse 패턴: 10, 20, 30...)
   * 클라이언트가 직접 보내지 않는다 — 메뉴 저장 시 options 배열 순서에서 파생된다.
   */
  sortOrder     Int                 @default(0) @map("sort_order")
  /// false면 고객 메뉴판에서 그룹 전체가 빠진다 (점주 콘솔에는 남는다)
  enabled       Boolean             @default(true)
  /// 조건부 노출 규칙. 규칙 간에는 AND, 한 규칙의 choiceIds 안에서는 OR.
  /// null이거나 빈 배열이면 항상 노출된다.
  /// 예시: [{ "optionId": "<원두 그룹 publicId>", "choiceIds": ["<케냐 publicId>"] }]
  /// 조회 조건으로 쓰이지 않고 로드 후 JS로만 평가하므로 값 객체 컬럼으로 둔다.
  /// 컬럼명이 trigger_rules인 이유: MySQL에서 TRIGGER가 예약어다.
  /// [MenuOptionTrigger]
  trigger       Json?               @map("trigger_rules")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  menu    Menu               @relation(fields: [menuId], references: [id], onDelete: Cascade)
  choices MenuOptionChoice[]

  @@unique([menuId, name])
  @@index([menuId, sortOrder])
  @@map("menu_option_group")
}

/**
 * 옵션 그룹 안의 개별 선택지(예: "HOT", "샷 1개 추가")
 */
model MenuOptionChoice {
  id              BigInt            @id @default(autoincrement())
  publicId        String            @unique @default(cuid(2)) @map("public_id")
  optionGroupId   BigInt            @map("option_group_id")
  name            String            @db.VarChar(30)
  /// 이 선택지가 더하는 금액(개당). quantity와 곱해진다. 할인 옵션을 위해 음수도 허용한다.
  priceDelta      Int               @default(0) @map("price_delta")
  quantityEnabled Boolean           @default(false) @map("quantity_enabled")
  maxQuantity     Int               @default(1) @map("max_quantity")
  isDefault       Boolean           @default(false) @map("is_default")
  /// 그룹 안 표시 순서 (Sparse 패턴). choices 배열 순서에서 파생된다.
  sortOrder       Int               @default(0) @map("sort_order")
  state           OptionChoiceState @default(AVAILABLE)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  option MenuOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@unique([optionGroupId, name])
  @@index([optionGroupId, sortOrder])
  @@map("menu_option_choice")
}

enum OrderStatus {
  /**
   * 주문을 접수하기 전 상태 @default
   */
  PENDING
  /**
   * 주문을 수락한 상태로 조리에 들어가기 직전 상태
   */
  ACCEPTED
  /**
   * 조리가 진행 중인 상태
   */
  PREPARING
  /**
   * 조리가 완료되어 픽업 및 서빙이 완료된 상태
   */
  COMPLETED
  /**
   * 주문이 취소된 상태, 복구할 수 없음
   */
  CANCELLED
}

/**
 * 고객이 주문하는 단위
 * 예) 아이스 아메리카노 얼음 적게 하나, 라떼 사이즈 라지 하나
 */
model Order {
  id              BigInt      @id @default(autoincrement())
  publicId        String      @unique @default(cuid(2)) @map("public_id")
  /**
   * 고객 주문 멱등성 키. 세션과 장바구니 업데이트 시점으로 기준으로 같은 장바구니로 동시에 여러 주문이 들어오는 것을 방지한다.
   * 관리자 주문은 사용하지 않으므로 nullable.
   */
  idempotencyKey  String?     @unique @map("idempotency_key")
  storeId         BigInt      @map("store_id")
  tableId         BigInt      @map("table_id")
  tableSessionId  BigInt      @map("table_session_id")
  status          OrderStatus @default(PENDING)
  /**
   * 영업일 키 "YYYY-MM-DD". createdAt의 날짜가 아니라 Store.businessDayCutoff로 계산한 값이다.
   * 새벽 2시 주문이 전날 장사에 묶이도록 하는 것이 이 컬럼의 존재 이유다.
   */
  businessDate    String      @map("business_date") @db.Char(10)
  /** 영업일 안에서의 순번. 채번·정렬은 이 값으로 한다. */
  orderSeq        Int         @map("order_seq")
  /**
   * 발행 시점의 표시용 번호("A-0001"). orderSeq에서 파생되지만 저장한다 —
   * Store.orderNumberPrefix가 바뀌어도 과거 주문의 번호는 발행 당시 값으로 남아야 한다.
   */
  orderNumber     String      @map("order_number") @db.VarChar(12)
  /**
   * 메뉴마다의 요청사항과 별개로 고객이 남기는 요청사항
   * 예) 해장국 덜 맵게 해주세요.
   */
  memo            String?     @db.VarChar(500)
  /**
   * 고객이 주문을 취소한 이유
   */
  cancelledReason String?     @map("cancelled_reason")
  acceptedAt      DateTime?   @map("accepted_at")
  completedAt     DateTime?   @map("completed_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  table        Table        @relation(fields: [tableId], references: [id], onDelete: Restrict)
  tableSession TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Restrict)
  orderItems   OrderItem[]

  @@unique([storeId, businessDate, orderSeq])
  @@index([tableSessionId])
  @@index([storeId, status, completedAt])
  @@map("order")
}

/**
 * 고객이 수량, 옵션과 함께 메뉴를 선택하는 단위
 * 예) 아이스 아메리카노 얼음 적게 하나
 */
model OrderItem {
  id              BigInt   @id @default(autoincrement())
  publicId        String   @unique @default(cuid(2)) @map("public_id")
  orderId         BigInt   @map("order_id")
  menuId          BigInt   @map("menu_id")
  menuName        String   @map("menu_name")
  menuImageUrl    String?  @map("menu_image_url") @db.VarChar(500)
  basePrice       Int      @map("base_price")
  optionsPrice    Int      @default(0) @map("options_price")
  unitPrice       Int      @map("unit_price")
  quantity        Int      @default(1)
  // 고객이 선택한 필수 및 선택 옵션들
  // 예) { "requiredOptions": { "사이즈": "라지" }, "customOptions": { "얼음": "적게" } }
  /// [OrderItemOptionSnapshot]
  optionsSnapshot Json?    @map("options_snapshot")
  createdAt       DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])
  menu  Menu  @relation(fields: [menuId], references: [id])

  @@index([orderId])
  @@index([menuId])
  @@map("order_item")
}

/**
 * 테이블 세션 상태 관리
 * activeSession 만료 시간을 테이블에서 보여줘야 하고 연장 기능도 필요하다.
 * 기본 세션 시간은 2시간으로 고정하고 연장하는 방식으로 한다.
 */
enum TableSessionStatus {
  /**
   * 세션은 생성되었지만 주문 대기 상태
   */
  WAITING_ORDER
  /**
   * 테이블이 활성화되어 주문이 가능한 상태
   */
  ACTIVE
  /**
   * 세션이 종료된 상태 (결제 완료 또는 만료)
   */
  CLOSED
}

model TableSession {
  id       BigInt             @id @default(autoincrement())
  publicId String             @unique @default(cuid(2)) @map("public_id")
  tableId  BigInt             @map("table_id")
  status   TableSessionStatus @default(WAITING_ORDER)

  /**
   * 세션 관리
   */
  sessionToken String    @unique @default(cuid(2)) @map("session_token")
  activatedAt  DateTime  @default(now()) @map("activated_at")
  expiresAt    DateTime  @map("expires_at")
  closedAt     DateTime? @map("closed_at")

  /**
   * 결제 정보
   * 결제를 orderItem 단위로 하는 것을 고려하면 별도의 Payment 모델이 필요하다.
   */
  paidAmount Int @default(0) @map("paid_amount")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  table  Table   @relation(fields: [tableId], references: [id])
  orders Order[]

  @@index([tableId, activatedAt])
  @@index([sessionToken])
  @@map("table_session")
}

