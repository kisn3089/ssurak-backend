# ============================================================================
# .env.example — 실제 값은 .env 에 작성 (.env 는 gitignore 대상)
#
# 배치 규칙:
#   - compose 보간용(${VAR}): compose 가 이 파일을 자동으로 읽어 치환한다.
#   - 컨테이너 주입: 시크릿(JWT_* 등)은 ssurak 서비스의 env_file 로만 들어간다.
#   - 토폴로지 종속 값(REDIS_HOST, 컨테이너용 DATABASE_URL 등)은 .env가 아니라
#     compose 의 environment: 블록에 정의되어 있다.
# ============================================================================

# --- MySQL (compose 보간 → mysql 서비스 environment) ---
DB_ROOT_PASSWORD=changeme-root
DB_NAME=ssurak
DB_USER=ssurak
DB_PASSWORD=changeme

# --- Redis (compose 보간 + ssurak 컨테이너에서 사용) ---
REDIS_PASSWORD=changeme
# 호스트에서 직접 실행할 때만 사용 (컨테이너는 compose environment 가 우선)
REDIS_HOST=localhost
REDIS_PORT=6379

# --- API 호스트 포트 매핑 (compose 보간) ---
SERVER_PORT=8080

# --- Prisma CLI 등 호스트 실행용 (컨테이너는 compose environment 가 우선) ---
DATABASE_URL=mysql://ssurak:changeme@localhost:3306/ssurak

# --- JWT (ssurak 컨테이너 env_file 주입) ---
JWT_ACCESS_TOKEN_SECRET=changeme
JWT_REFRESH_TOKEN_SECRET=changeme
JWT_ACCESS_TOKEN_EXPIRATION_MS=86400000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
JWT_ISSUER=ssurak
JWT_AUDIENCE=ssurak

# --- CORS / 쿠키 (prod 전용 — dev 는 compose 에 localhost 로 하드코딩) ---
ORDER_APP_URL=https://order.ssurak.com
CONSOLE_APP_URL=https://console.ssurak.com
COOKIE_DOMAIN=.ssurak.com

# --- Cloudflare Tunnel (prod 전용, compose 보간) ---
CLOUDFLARE_TUNNEL_TOKEN=eyJ...

# --- AWS S3 / CloudFront (메뉴 이미지 스토리지) ---
# 자격증명(AWS_ACCESS_KEY_ID 등)은 여기 두지 않는다. `aws configure --profile`로
# 만든 ~/.aws를 컨테이너에 읽기 전용 마운트하고, 프로필명은 compose의
# environment: 에서 AWS_PROFILE 로 지정한다(dev=ssurak-dev, prod=ssurak-prod).
# 운영이 홈서버라 ECS Task Role 같은 자동 자격증명은 없다.
#
# AWS_PROFILE을 이 파일에 두면 안 된다 — ConfigModule이 process.env를 채우는
# 시점에 의존하게 되어 SDK 기본 체인이 못 볼 수 있다.
#
# aws 호스트 격리를 위해서 아래 실행 필요
# AWS_SHARED_CREDENTIALS_FILE=~/.aws-ssurak-prod/credentials \
# AWS_CONFIG_FILE=~/.aws-ssurak-prod/config \
# aws configure --profile ssurak-prod
AWS_REGION=ap-northeast-2
S3_BUCKET=ssurak-media-dev
# CloudFront 배포 도메인. 버킷은 OAC로 비공개라 S3 직접 URL은 동작하지 않는다.
CDN_BASE_URL=https://dxxxxxxxxxxxxx.cloudfront.net

# --- OpenAI (메뉴판 사진 인식) ---
# 메뉴판 사진에서 메뉴 초안을 추출하는 데만 쓴다(POST /stores/v1/:storeId/menus/draft).
# 키가 없으면 OpenAiModule이 부팅 시점에 죽는다 — 인식 기능을 안 쓸 환경에서도 값은 필요하다.
OPENAI_API_KEY=sk-...
# 비워두면 gpt-5.6-luna. 인식률이 부족하면 상위 모델로 올린다(비용은 입력 이미지 토큰이 지배한다).
OPENAI_MENU_VISION_MODEL=gpt-5.6-luna
# 요청 하나에 허용할 시간. ALB/nginx 기본 idle timeout(60초) 안쪽이어야
# 게이트웨이가 먼저 끊어 원인 불명의 502가 나가지 않는다.
OPENAI_MENU_VISION_TIMEOUT_MS=55000
# 점주 1인당 인식 횟수와 그 창의 길이. 인증된 요청이 그대로 토큰 비용이다.
# 매장이 아닌 점주 기준이라, 매장을 여럿 가진 점주도 총량은 하나로 묶인다.
# 고정 창이라 상한을 채우면 창이 닫힐 때까지 막힌다. 창을 짧게 두면 상한이 낮아도
# 사진 각도를 바꿔가며 재시도하다 오래 잠기는 일은 없다.
# 여기 값과 envSchemas의 default를 함께 움직여야 한다 — 환경변수 없이 뜨는 곳은 default를 쓴다.
MENU_DRAFT_RATE_LIMIT=5
MENU_DRAFT_RATE_WINDOW_HOURS=2
