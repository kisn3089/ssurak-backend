# ============================================================================
# .env.example — 실제 값은 .env 에 작성 (.env 는 gitignore 대상)
#
# 배치 규칙:
#   - compose 보간용(${VAR}): compose 가 이 파일을 자동으로 읽어 치환한다.
#   - 컨테이너 주입: 시크릿(JWT_* 등)은 ssurak 서비스의 env_file 로만 들어간다.
#   - 토폴로지 종속 값(REDIS_HOST, 컨테이너용 DATABASE_URL 등)은 .env 가 아니라
#     compose 의 environment: 블록에 정의되어 있다.
# ============================================================================

# --- MySQL (compose 보간 → mysql 서비스 environment) ---
DB_ROOT_PASSWORD=changeme-root
DB_NAME=ssurak
DB_USER=ssurak
DB_PASSWORD=changeme

# --- Redis (compose 보간 + ssurak 컨테이너에서 사용) ---
REDIS_PASSWORD=changeme
# 호스트에서 직접 실행할 때만 사용 (컨테이너는 compose environment 가 우선)
REDIS_HOST=localhost
REDIS_PORT=6379

# --- API 호스트 포트 매핑 (compose 보간) ---
SERVER_PORT=8080

# --- Prisma CLI 등 호스트 실행용 (컨테이너는 compose environment 가 우선) ---
DATABASE_URL=mysql://ssurak:changeme@localhost:3306/ssurak

# --- JWT (ssurak 컨테이너 env_file 주입) ---
JWT_ACCESS_TOKEN_SECRET=changeme
JWT_REFRESH_TOKEN_SECRET=changeme
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
JWT_ISSUER=ssurak
JWT_AUDIENCE=ssurak

# --- CORS / 쿠키 (prod 전용 — dev 는 compose 에 localhost 로 하드코딩) ---
ORDER_APP_URL=https://order.ssurak.com
CONSOLE_APP_URL=https://console.ssurak.com
COOKIE_DOMAIN=.ssurak.com

# --- Cloudflare Tunnel (prod 전용, compose 보간) ---
CLOUDFLARE_TUNNEL_TOKEN=eyJ...
